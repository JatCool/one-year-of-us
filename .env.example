# Copy this file to `.env` and fill in the values from
# Supabase → Project Settings → API. Never commit `.env`.
#
# Project URL, e.g. https://abcdefghijklmnop.supabase.co
VITE_SUPABASE_URL=
# The "anon public" key (NOT the service_role key).
VITE_SUPABASE_ANON_KEY=

# Optional: URL path the site is served from. Leave empty for local development.
# The GitHub Pages workflow sets it automatically to /<repository-name>/.
# VITE_BASE_PATH=/
